generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String   @id @default(uuid())
  firstName        String?
  lastName         String?
  gender           String?
  bloodGroup       String?
  phone            String?
  email            String   @unique
  role             Role     @default(patient)
  profileCompleted Boolean  @default(false)
  isApproved       Boolean  @default(true)
  specialization   String?
  qualification    String?
  licenseNumber    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  patientAppointments  Appointment[] @relation("PatientAppointments")
  doctorAppointments   Appointment[] @relation("DoctorAppointments")
  doctorConsultations  Consultation[] @relation("DoctorConsultations")
  patientConsultations Consultation[] @relation("PatientConsultations")

  @@map("user")
}

model Appointment {
  id              String   @id @default(uuid())
  patientId       String
  doctorId        String
  appointmentDate String
  startTime       String
  status          Status   @default(scheduled)
  reason          String?
  tokenNumber     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient      User          @relation("PatientAppointments", fields: [patientId], references: [id])
  doctor       User          @relation("DoctorAppointments", fields: [doctorId], references: [id])
  consultation Consultation?

  @@map("appointment")
}

model Consultation {
  id              String   @id @default(uuid())
  appointmentId   String   @unique
  doctorId        String
  patientId       String
  diagnosis       String   @db.Text
  symptoms        String?  @db.Text
  notes           String?  @db.Text
  vitalBP         String?
  vitalTemp       String?
  vitalPulse      String?
  vitalWeight     String?
  treatmentPlan   String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  appointment  Appointment          @relation(fields: [appointmentId], references: [id])
  doctor       User                 @relation("DoctorConsultations", fields: [doctorId], references: [id])
  patient      User                 @relation("PatientConsultations", fields: [patientId], references: [id])
  prescriptions Prescription[]
  certificates  MedicalCertificate[]

  @@map("consultation")
}

model Prescription {
  id              String   @id @default(uuid())
  consultationId  String
  medicines       Json
  additionalNotes String?  @db.Text
  createdAt       DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@map("prescription")
}

model MedicalCertificate {
  id              String   @id @default(uuid())
  consultationId  String
  reason          String
  validFrom       DateTime
  validTo         DateTime
  additionalNotes String?  @db.Text
  createdAt       DateTime @default(now())

  consultation Consultation @relation(fields: [consultationId], references: [id])

  @@map("medicalcertificate")
}

enum Role {
  patient
  doctor
  admin
}

enum Status {
  scheduled
  in_progress
  completed
  cancelled
}
